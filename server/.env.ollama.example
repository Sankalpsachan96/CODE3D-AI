# Optional local AI provider for CODE3D-AI
# 1. Install Ollama on the computer that runs the backend.
# 2. Download a small Qwen model, e.g.:
#    ollama pull qwen2.5:3b-instruct
#    (Or try qwen2.5:4b-instruct if you have enough memory.)
# 3. Set AI_PROVIDER=ollama in your local server .env.
# 4. Make sure Ollama is running and the backend can reach it.

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Existing hosted option remains available:
# AI_PROVIDER=groq
# GROQ_API_KEY=your-key
# GROQ_MODEL=openai/gpt-oss-120b
